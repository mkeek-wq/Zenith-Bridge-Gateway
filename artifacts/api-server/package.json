{
  "name": "zenith-api-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "pnpm run clean && pnpm run build:ts",
    "build:ts": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "replay:case-completeness": "tsx src/scripts/case-completeness-engine-v0.1.ts",
    "replay:proposals": "tsx src/scripts/replay-improvement-proposal-engine-v0.1.ts",
    "replay:proposal-registry": "tsx src/scripts/replay-proposal-registry-v0.1.ts",
    "replay:proposal-cycle": "pnpm replay:case-completeness && pnpm replay:proposals && pnpm replay:proposal-registry",
    "replay:proposal-dashboard": "tsx src/scripts/build-replay-proposal-dashboard-v0.1.ts",
    "replay:approve": "tsx src/scripts/approve-replay-proposal-v0.1.ts",
    "replay:shadow": "tsx src/scripts/build-replay-shadow-execution-v0.1.ts",
    "replay:audit": "tsx src/scripts/build-replay-audit-engine-v0.1.ts",
    "replay:promote": "tsx src/scripts/promote-replay-proposal-v0.1.ts",
    "replay:reject": "tsx src/scripts/reject-replay-proposal-v0.1.ts",
    "replay:improvement-history": "tsx src/scripts/build-replay-improvement-history-v0.1.ts",
    "replay:governance-history": "tsx src/scripts/build-replay-governance-history-v0.1.ts",
    "replay:confidence-history": "tsx src/scripts/build-replay-confidence-history-v0.1.ts",
    "replay:improvement-report": "tsx src/scripts/build-replay-improvement-report-v0.1.ts",
    "replay:governance-cycle": "pnpm replay:proposal-cycle && pnpm replay:proposal-dashboard && pnpm replay:shadow && pnpm replay:audit && pnpm replay:improvement-history && pnpm replay:governance-history && pnpm replay:confidence-history && pnpm replay:improvement-report"
  },
  "dependencies": {
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "latest",
    "express": "^5.0.0",
    "express-rate-limit": "^8.5.0",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "openai": "^6.42.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.27.0",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
