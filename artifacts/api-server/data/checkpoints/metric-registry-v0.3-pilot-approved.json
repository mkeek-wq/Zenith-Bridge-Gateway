{
  "registry_version": "metric-registry-v0.3",
  "governance_principle": "Metric names must be stable, explicit, and conservative. Metric keywords identify what is being measured, not how it is compared. Comparison phrases such as year-on-year, month-on-month, previous month, and compared to belong in comparison_basis logic, not metric identity. If a metric cannot be classified confidently, use UNCLASSIFIED_PERCENTAGE rather than forcing a label.",
  "naming_convention": {
    "style": "UPPER_SNAKE_CASE",
    "pattern": "DOMAIN_METRIC_MEASURE_BASIS",
    "examples": [
      "GDP_GROWTH_YOY",
      "CPI_GROWTH_MOM",
      "MANUFACTURING_OUTPUT_CHANGE_MOM",
      "INDUSTRIAL_OCCUPANCY_RATE",
      "CORPORATE_SECTOR_TOTAL_ASSETS_CHANGE_YOY"
    ]
  },
  "fallback_metric": {
    "metric_code": "UNCLASSIFIED_PERCENTAGE",
    "metric_label": "Unclassified percentage",
    "use_when": "A percentage is detected but the surrounding context does not match an approved metric definition with sufficient confidence."
  },
